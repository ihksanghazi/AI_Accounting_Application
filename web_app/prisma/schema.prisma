// web_app/prisma/schema.prisma

// Mendefinisikan koneksi ke database.
// Prisma akan mencari variabel DATABASE_URL di environment.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mendefinisikan generator untuk Prisma Client, yang akan kita gunakan
// untuk berinteraksi dengan database dari kode Next.js.
generator client {
  provider = "prisma-client-js" // <-- INI YANG BENAR
}

// --- Model Data ---

// Model untuk Pengguna
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi: Satu User memiliki satu Company
  company   Company?
}

// Model untuk Perusahaan yang dibuat oleh User
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi: Satu Company dimiliki oleh satu User
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id])

  // Relasi: Satu Company memiliki banyak Akun, Transaksi
  accounts     Account[]
  transactions Transaction[]
}

// Model untuk Daftar Akun (Chart of Accounts)
model Account {
  id          String    @id @default(cuid())
  name        String // e.g., "Kas", "Beban Listrik", "Pendapatan Jasa"
  code        String? // e.g., "1101" untuk Kas
  type        String // e.g., "ASET", "LIABILITAS", "EKUITAS", "PENDAPATAN", "BEBAN"
  createdAt   DateTime  @default(now())

  // Relasi: Satu Akun dimiliki oleh satu Company
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])

  // Relasi: Satu Akun bisa ada di banyak entri jurnal
  journalEntries JournalEntry[]

  @@unique([companyId, name]) // Nama akun harus unik per perusahaan
}

// Model untuk setiap Transaksi (seperti satu nota pembelian)
model Transaction {
  id           String   @id @default(cuid())
  date         DateTime
  description  String
  createdAt    DateTime @default(now())

  // Relasi: Satu Transaksi dimiliki oleh satu Company
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])

  // Relasi: Satu Transaksi memiliki banyak entri jurnal (debit/kredit)
  journalEntries JournalEntry[]
}

// Model untuk Jurnal Entri (baris Debit/Kredit dalam sebuah transaksi)
model JournalEntry {
  id        String       @id @default(cuid())
  type      JournalType // Tipe entri: DEBIT atau KREDIT
  amount    Float

  // Relasi: Satu Entri Jurnal milik satu Transaksi
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id])

  // Relasi: Satu Entri Jurnal terkait dengan satu Akun
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
}

enum JournalType {
  DEBIT
  KREDIT
}